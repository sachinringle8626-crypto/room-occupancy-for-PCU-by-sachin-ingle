@media(max-width:600px){header{padding:12px;align-items:flex-start}.header-right{flex-direction:column;align-items:flex-end}.subbrand{display:none}main{padding:15px}.stats,.two,.three,.room-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.page-head{flex-direction:column}}
