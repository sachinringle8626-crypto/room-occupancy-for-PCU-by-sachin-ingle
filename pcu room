<script>
const KEY='roomsync_demo_v1';
const seed={
 buildings:[{id:'b1',code:'A',name:'Building A',address:'University Campus',status:'ACTIVE'},{id:'b2',code:'B',name:'Building B',address:'University Campus',status:'ACTIVE'},{id:'b3',code:'C',name:'Building C',address:'University Campus',status:'ACTIVE'}],
 floors:[{id:'f1',buildingId:'b1',name:'Ground Floor',order:0},{id:'f2',buildingId:'b1',name:'First Floor',order:1},{id:'f3',buildingId:'b3',name:'Sixth Floor',order:6},{id:'f4',buildingId:'b3',name:'Seventh Floor',order:7}],
 rooms:[
 {id:'r1',floorId:'f3',number:'601',type:'Classroom',department:'FY B.Tech',capacity:60,seats:60,area:75,status:'ACTIVE',published:true,features:['Projector','Wi-Fi','AC'],incharge:'Room In-charge'},
 {id:'r2',floorId:'f3',number:'602',type:'Classroom',department:'FY B.Tech',capacity:60,seats:55,area:72,status:'ACTIVE',published:true,features:['Projector','Wi-Fi'],incharge:'Room In-charge'},
 {id:'r3',floorId:'f3',number:'603',type:'Computer Lab',department:'CSE',capacity:30,seats:30,area:85,status:'ACTIVE',published:true,features:['Computers','AC','Wi-Fi'],incharge:'Lab In-charge'},
 {id:'r4',floorId:'f4',number:'701',type:'Seminar Hall',department:'Central',capacity:100,seats:90,area:140,status:'ACTIVE',published:true,features:['Projector','Smart Board','AC'],incharge:'Facility Team'},
 {id:'r5',floorId:'f1',number:'101',type:'Meeting Room',department:'Administration',capacity:20,seats:16,area:35,status:'MAINTENANCE',published:true,features:['Display','Wi-Fi'],incharge:'Admin'}
 ],
 bookings:[
 {id:'BK-1001',roomId:'r1',requester:'Demo Faculty',purpose:'FY B.Tech Lecture',attendees:55,date:today(),start:'09:00',end:'10:00',type:'TIMETABLE',status:'APPROVED',remarks:'Regular class'},
 {id:'BK-1002',roomId:'r2',requester:'Demo Faculty',purpose:'Department Meeting',attendees:18,date:today(),start:'14:00',end:'15:00',type:'ADHOC',status:'PENDING',remarks:'Monthly meeting'}
 ],
 occupancy:[{id:'oc1',roomId:'r1',date:today(),start:'09:05',end:'09:55',actual:48,scheduled:55,status:'USED',verifiedBy:'Administrator',remarks:'Lecture conducted'}],
 maintenance:[{id:'m1',roomId:'r5',start:today(),end:today(),issue:'Electrical maintenance',status:'OPEN'}],
 timetable:[{id:'t1',roomId:'r1',day:'Monday',start:'09:00',end:'10:00',className:'FY B.Tech Div A',department:'FY B.Tech',strength:60,faculty:'Assigned Faculty'}]
};
let db=loadDB(), page='dashboard', role='ADMIN';
function today(){return new Date().toISOString().slice(0,10)}
function loadDB(){try{return JSON.parse(localStorage.getItem(KEY))||structuredClone(seed)}catch(e){return JSON.parse(JSON.stringify(seed))}}
function save(){localStorage.setItem(KEY,JSON.stringify(db))}
function uid(prefix='id'){return prefix+'_'+Math.random().toString(36).slice(2,9)}
function esc(v=''){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function buildingOfFloor(id){return db.buildings.find(b=>b.id===db.floors.find(f=>f.id===id)?.buildingId)}
function floorOfRoom(r){return db.floors.find(f=>f.id===r.floorId)}
function roomName(id){let r=db.rooms.find(x=>x.id===id);if(!r)return 'Unknown room';let f=floorOfRoom(r),b=f&&buildingOfFloor(f.id);return `${b?.code||'?'}-${r.number}`}
function badge(status){let cls=['ACTIVE','APPROVED','USED','COMPLETED'].includes(status)?'green':['PENDING','MAINTENANCE','PARTIAL'].includes(status)?'amber':['REJECTED','BLOCKED','UNUSED','NO_SHOW'].includes(status)?'red':'blue';return `<span class="badge ${cls}">${esc(status)}</span>`}
function toast(msg){let el=document.getElementById('toast');el.textContent=msg;el.style.display='block';setTimeout(()=>el.style.display='none',2600)}
function canAdmin(){return role==='ADMIN'}
function canBook(){return ['ADMIN','INCHARGE','FACULTY'].includes(role)}
function canApprove(){return ['ADMIN','INCHARGE'].includes(role)}
function go(p){page=p;document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===p));render()}
document.getElementById('nav').addEventListener('click',e=>{let b=e.target.closest('button[data-page]');if(b)go(b.dataset.page)});
document.getElementById('roleSelect').addEventListener('change',e=>{role=e.target.value;document.getElementById('currentUserLabel').textContent={ADMIN:'Demo administrator',INCHARGE:'Demo room in-charge',FACULTY:'Demo faculty / staff',PUBLIC:'Public visitor'}[role];render()});
function head(title,desc,action=''){return `<div class="page-head"><div><h1>${title}</h1><div class="muted">${desc}</div></div>${action}</div>`}
function stat(label,value,note=''){return `<div class="card"><div class="stat-title">${label}</div><div class="stat-number">${value}</div><div class="tiny muted">${note}</div></div>`}
function render(){let m=document.getElementById('main');switch(page){
case'dashboard':m.innerHTML=dashboard();break;case'search':m.innerHTML=searchPage();break;case'buildings':m.innerHTML=buildingsPage();break;case'rooms':m.innerHTML=roomsPage();break;case'timetable':m.innerHTML=timetablePage();break;case'bookings':m.innerHTML=bookingsPage();break;case'occupancy':m.innerHTML=occupancyPage();break;case'maintenance':m.innerHTML=maintenancePage();break;case'reports':m.innerHTML=reportsPage();break;} }
function dashboard(){let active=db.rooms.filter(r=>r.status==='ACTIVE').length,pending=db.bookings.filter(b=>b.status==='PENDING').length,approved=db.bookings.filter(b=>b.status==='APPROVED').length,maintenance=db.rooms.filter(r=>r.status==='MAINTENANCE').length;let used=db.occupancy.filter(o=>o.date===today()&&o.status==='USED').length;
return head('University overview','A consolidated view of rooms, bookings and occupancy.')+`<div class="grid stats">${stat('Buildings',db.buildings.length,'Registered buildings')}${stat('Total rooms',db.rooms.length,'Published and draft rooms')}${stat('Active rooms',active,'Operational rooms')}${stat('Pending approvals',pending,'Requests awaiting action')}</div><div class="grid two"><section class="card"><h2>Room status</h2><div class="grid three">${stat('Approved bookings',approved,'Current records')}${stat('Maintenance',maintenance,'Unavailable rooms')}${stat('Occupancy entries today',used,'Manually recorded')}</div><p class="tiny muted">Room status and occupancy are different: an active room may be vacant, booked or occupied at a particular time.</p></section><section class="card"><h2>Quick actions</h2><div class="actions"><button onclick="go('search')">Find a room</button>${canAdmin()?'<button class="secondary" onclick="openBuildingForm()">Add building</button><button class="secondary" onclick="openRoomForm()">Register room</button>':''}${canBook()?'<button class="secondary" onclick="openBookingForm()">Request booking</button>':''}<button class="secondary" onclick="go('occupancy')">Enter occupancy</button></div><hr style="border:0;border-top:1px solid var(--line);margin:18px 0"><h2>Pending requests</h2>${pending?db.bookings.filter(b=>b.status==='PENDING').slice(0,4).map(b=>`<p class="tiny">${roomName(b.roomId)} · ${esc(b.purpose)} · ${esc(b.date)} ${badge(b.status)}</p>`).join(''):'<p class="muted tiny">No pending requests.</p>'}</section></div><div class="card" style="margin-top:14px"><h2>Recently registered rooms</h2>${roomTable(db.rooms.slice(-5).reverse())}</div>`}
function searchPage(){return head('Find a room','Public room search is available without signing in.')+`<div class="card"><div class="toolbar"><input id="q" placeholder="Search room number, building or department" oninput="filterRooms()"><select id="typeFilter" onchange="filterRooms()"><option value="">All room types</option>${['Classroom','Computer Lab','Civil Lab','Science Lab','Seminar Hall','Meeting Room','Faculty Room','Office','Library'].map(x=>`<option>${x}</option>`).join('')}</select><select id="buildingFilter" onchange="filterRooms()"><option value="">All buildings</option>${db.buildings.map(b=>`<option value="${b.id}">${esc(b.name)}</option>`).join('')}</select><select id="statusFilter" onchange="filterRooms()"><option value="">All operational states</option><option value="ACTIVE">Active</option><option value="MAINTENANCE">Maintenance</option></select></div><div id="searchResults" class="grid room-grid">${roomCards(db.rooms.filter(r=>r.published))}</div></div>`}
function filterRooms(){let q=document.getElementById('q').value.toLowerCase(),t=document.getElementById('typeFilter').value,b=document.getElementById('buildingFilter').value,s=document.getElementById('statusFilter').value;let list=db.rooms.filter(r=>r.published).filter(r=>{let f=floorOfRoom(r),bu=f&&buildingOfFloor(f.id);return (!q||[r.number,r.department,r.type,bu?.name,bu?.code].join(' ').toLowerCase().includes(q))&&(!t||r.type===t)&&(!b||f?.buildingId===b)&&(!s||r.status===s)});document.getElementById('searchResults').innerHTML=roomCards(list)}
function roomCards(list){if(!list.length)return '<div class="empty">No matching published rooms found.</div>';return list.map(r=>{let f=floorOfRoom(r),b=f&&buildingOfFloor(f.id);return `<article class="room-card"><div style="display:flex;justify-content:space-between;gap:8px"><h3>${esc(b?.code||'')}-${esc(r.number)}</h3>${badge(r.status)}</div><div class="room-meta">${esc(r.type)} · ${esc(b?.name||'')} · ${esc(f?.name||'')}</div><div class="room-meta">Department: ${esc(r.department||'Not assigned')}</div><div class="room-meta">Capacity: ${r.seats} usable seats / ${r.capacity} design capacity</div><div class="room-meta">Facilities: ${esc((r.features||[]).join(', ')||'Not specified')}</div><div class="room-actions">${canBook()&&r.status==='ACTIVE'?`<button class="small" onclick="openBookingForm('${r.id}')">Request booking</button>`:''}<button class="small secondary" onclick="roomDetails('${r.id}')">Details</button></div></article>`}).join('')}
function roomDetails(id){let r=db.rooms.find(x=>x.id===id),f=floorOfRoom(r),b=buildingOfFloor(f.id);alert(`${b.name} · ${f.name} · Room ${r.number}\\nType: ${r.type}\\nCapacity: ${r.seats}\\nArea: ${r.area||'Not entered'} sq.m\\nIn-charge: ${r.incharge}\\nFacilities: ${(r.features||[]).join(', ')}`)}
function buildingsPage(){return head('Buildings & floors','Register the university campus structure.',canAdmin()?'<button onclick="openBuildingForm()">+ Add building</button>':'')+`<div class="grid two">${db.buildings.map(b=>`<div class="card"><div style="display:flex;justify-content:space-between"><h2>${esc(b.name)}</h2>${badge(b.status)}</div><div class="muted tiny">Code: ${esc(b.code)} · ${esc(b.address||'')}</div><hr style="border:0;border-top:1px solid var(--line);margin:13px 0"><b>Floors</b><div class="tiny muted">${db.floors.filter(f=>f.buildingId===b.id).map(f=>esc(f.name)).join(' · ')||'No floors added'}</div><p class="tiny muted">${db.rooms.filter(r=>db.floors.some(f=>f.id===r.floorId&&f.buildingId===b.id)).length} registered rooms</p>${canAdmin()?`<button class="small secondary" onclick="openFloorForm('${b.id}')">+ Add floor</button>`:''}</div>`).join('')}</div><div class="card" style="margin-top:14px"><h2>Floor register</h2><div class="table-wrap"><table><thead><tr><th>Building</th><th>Floor</th><th>Rooms</th></tr></thead><tbody>${db.floors.map(f=>`<tr><td>${esc(db.buildings.find(b=>b.id===f.buildingId)?.name||'')}</td><td>${esc(f.name)}</td><td>${db.rooms.filter(r=>r.floorId===f.id).length}</td></tr>`).join('')}</tbody></table></div></div>`}
function roomsPage(){return head('Room register','Maintain the master inventory and publish rooms to public search.',canAdmin()?'<button onclick="openRoomForm()">+ Register room</button>':'')+`<div class="card"><div class="toolbar"><input id="roomQ" placeholder="Search room number / department" oninput="filterRoomTable()"><select id="roomStatus" onchange="filterRoomTable()"><option value="">All statuses</option><option>ACTIVE</option><option>MAINTENANCE</option><option>BLOCKED</option></select></div><div id="roomTable">${roomTable(db.rooms)}</div></div>`}
function roomTable(list){return `<div class="table-wrap"><table><thead><tr><th>Room</th><th>Building / Floor</th><th>Type</th><th>Department</th><th>Capacity</th><th>Status</th><th>Published</th></tr></thead><tbody>${list.map(r=>{let f=floorOfRoom(r),b=f&&buildingOfFloor(f.id);return `<tr><td><b>${esc(b?.code||'')}-${esc(r.number)}</b></td><td>${esc(b?.name||'')} / ${esc(f?.name||'')}</td><td>${esc(r.type)}</td><td>${esc(r.department)}</td><td>${r.seats}/${r.capacity}</td><td>${badge(r.status)}</td><td>${r.published?'Yes':'No'}</td></tr>`}).join('')||'<tr><td colspan="7">No rooms registered.</td></tr>'}</tbody></table></div>`}
function filterRoomTable(){let q=document.getElementById('roomQ').value.toLowerCase(),s=document.getElementById('roomStatus').value;let list=db.rooms.filter(r=>(!q||[r.number,r.department,r.type,roomName(r.id)].join(' ').toLowerCase().includes(q))&&(!s||r.status===s));document.getElementById('roomTable').innerHTML=roomTable(list)}
function timetablePage(){return head('Timetable allocation','Recurring academic room allocations. Admin can create and review timetable slots.',canAdmin()?'<button onclick="openTimetableForm()">+ Add timetable slot</button>':'')+`<div class="card">${db.timetable.length?`<div class="table-wrap"><table><thead><tr><th>Day</th><th>Room</th><th>Class / batch</th><th>Department</th><th>Time</th><th>Strength</th><th>Faculty</th></tr></thead><tbody>${db.timetable.map(t=>`<tr><td>${esc(t.day)}</td><td>${roomName(t.roomId)}</td><td>${esc(t.className)}</td><td>${esc(t.department)}</td><td>${t.start}–${t.end}</td><td>${t.strength}</td><td>${esc(t.faculty)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">No timetable allocations yet.</div>'}</div>`}
function bookingsPage(){let list=db.bookings.slice().sort((a,b)=>a.date.localeCompare(b.date));return head('Bookings & approvals','Review requests and track approved room reservations.',canBook()?'<button onclick="openBookingForm()">+ Request booking</button>':'')+`<div class="card"><div class="toolbar"><select id="bookingFilter" onchange="filterBookings()"><option value="">All statuses</option>${['PENDING','APPROVED','REJECTED','CANCELLED','COMPLETED'].map(s=>`<option>${s}</option>`).join('')}</select></div><div id="bookingTable">${bookingTable(list)}</div></div>`}
function bookingTable(list){return `<div class="table-wrap"><table><thead><tr><th>Reference</th><th>Room</th><th>Date / time</th><th>Purpose</th><th>Requested by</th><th>Attendance</th><th>Status</th><th>Action</th></tr></thead><tbody>${list.map(b=>`<tr><td>${esc(b.id)}</td><td>${roomName(b.roomId)}</td><td>${b.date}<br>${b.start}–${b.end}</td><td>${esc(b.purpose)}</td><td>${esc(b.requester)}</td><td>${b.attendees}</td><td>${badge(b.status)}</td><td>${b.status==='PENDING'&&canApprove()?`<button class="small" onclick="decideBooking('${b.id}','APPROVED')">Approve</button> <button class="small danger" onclick="decideBooking('${b.id}','REJECTED')">Reject</button>`:''}${['PENDING','APPROVED'].includes(b.status)&&canBook()?` <button class="small secondary" onclick="cancelBooking('${b.id}')">Cancel</button>`:''}</td></tr>`).join('')||'<tr><td colspan="8">No bookings found.</td></tr>'}</tbody></table></div>`}
function filterBookings(){let s=document.getElementById('bookingFilter').value;document.getElementById('bookingTable').innerHTML=bookingTable(db.bookings.filter(b=>!s||b.status===s))}
function decideBooking(id,status){let b=db.bookings.find(x=>x.id===id);if(!b)return;if(status==='APPROVED'&&!bookingValid(b.roomId,b.date,b.start,b.end,b.attendees,id))return;let note=prompt(status==='APPROVED'?'Approval remarks (optional):':'Reason for rejection:','');if(status==='REJECTED'&&note===null)return;b.status=status;b.decisionBy='Demo approver';b.decisionRemarks=note||'';save();render();toast('Booking '+status.toLowerCase())}
function cancelBooking(id){let b=db.bookings.find(x=>x.id===id);if(b&&confirm('Cancel this booking?')){b.status='CANCELLED';save();render();toast('Booking cancelled')}}
function occupancyPage(){return head('Manual occupancy entry','Record actual use separately from the approved booking.',canApprove()?'<button onclick="openOccupancyForm()">+ Record occupancy</button>':'')+`<div class="card"><div class="table-wrap"><table><thead><tr><th>Date</th><th>Room</th><th>Actual time</th><th>Scheduled strength</th><th>Actual occupants</th><th>Use status</th><th>Verified by</th></tr></thead><tbody>${db.occupancy.map(o=>`<tr><td>${o.date}</td><td>${roomName(o.roomId)}</td><td>${o.start}–${o.end}</td><td>${o.scheduled??'—'}</td><td>${o.actual}</td><td>${badge(o.status)}</td><td>${esc(o.verifiedBy)}</td></tr>`).join('')||'<tr><td colspan="7">No occupancy records.</td></tr>'}</tbody></table></div></div>`}
function maintenancePage(){return head('Maintenance & room downtime','Record issues and prevent bookings during blocked periods.',canAdmin()?'<button onclick="openMaintenanceForm()">+ Block a room</button>':'')+`<div class="card"><div class="table-wrap"><table><thead><tr><th>Room</th><th>Period</th><th>Issue</th><th>Status</th><th>Action</th></tr></thead><tbody>${db.maintenance.map(m=>`<tr><td>${roomName(m.roomId)}</td><td>${m.start} to ${m.end}</td><td>${esc(m.issue)}</td><td>${badge(m.status)}</td><td>${canAdmin()&&m.status==='OPEN'?`<button class="small secondary" onclick="resolveMaintenance('${m.id}')">Resolve</button>`:''}</td></tr>`).join('')||'<tr><td colspan="5">No maintenance records.</td></tr>'}</tbody></table></div></div>`}
function resolveMaintenance(id){let m=db.maintenance.find(x=>x.id===id);if(m){m.status='RESOLVED';let r=db.rooms.find(x=>x.id===m.roomId);if(r)r.status='ACTIVE';save();render();toast('Maintenance resolved')}}
function reportsPage(){let active=db.rooms.filter(r=>r.status==='ACTIVE').length,entries=db.occupancy.filter(o=>o.status==='USED'),totalHours=entries.reduce((n,o)=>n+((mins(o.end)-mins(o.start))/60),0),possible=active*8,util=possible?Math.round(totalHours/possible*100):0;return head('Reports & analytics','Illustrative metrics calculated from the records entered in this prototype.',`<button onclick="exportCSV()">Export CSV</button>`)+`<div class="grid stats">${stat('Registered rooms',db.rooms.length,'All room records')}${stat('Active rooms',active,'Operational')}${stat('Occupancy entries',db.occupancy.length,'Manual records')}${stat('Recorded occupied hours',totalHours.toFixed(1),'From entered usage')}</div><div class="grid two"><div class="card"><h2>Building-wise room inventory</h2>${db.buildings.map(b=>{let n=db.rooms.filter(r=>{let f=floorOfRoom(r);return f?.buildingId===b.id}).length;return `<p class="tiny"><b>${esc(b.name)}</b> <span style="float:right">${n} rooms</span></p><div class="progress"><span style="width:${db.rooms.length?n/db.rooms.length*100:0}%"></span></div>`}).join('')}</div><div class="card"><h2>Occupancy data quality</h2><p class="tiny muted">Room utilisation requires a defined operational calendar and complete actual-use entries. The figure below is a basic demonstration, not a verified institutional utilisation KPI.</p><div class="stat-number">${util}%</div><div class="tiny muted">Recorded occupied hours / (active rooms × 8-hour reference day)</div></div></div><div class="card" style="margin-top:14px"><h2>Department-wise inventory</h2><div class="table-wrap"><table><thead><tr><th>Department</th><th>Rooms</th><th>Usable seats</th></tr></thead><tbody>${[...new Set(db.rooms.map(r=>r.department||'Unassigned'))].map(d=>{let rs=db.rooms.filter(r=>(r.department||'Unassigned')===d);return `<tr><td>${esc(d)}</td><td>${rs.length}</td><td>${rs.reduce((n,r)=>n+r.seats,0)}</td></tr>`}).join('')}</tbody></table></div></div>`}
function mins(t){let [h,m]=t.split(':').map(Number);return h*60+m}
function exportCSV(){let rows=[['Room','Building','Floor','Type','Department','Design capacity','Usable seats','Status','Published']];db.rooms.forEach(r=>{let f=floorOfRoom(r),b=f&&buildingOfFloor(f.id);rows.push([r.number,b?.name,f?.name,r.type,r.department,r.capacity,r.seats,r.status,r.published?'Yes':'No'])});let csv=rows.map(row=>row.map(x=>'"'+String(x??'').replace(/"/g,'""')+'"').join(',')).join('\n');download('roomsync-room-register.csv',csv,'text/csv');}
function download(name,content,type){let a=document.createElement('a'),url=URL.createObjectURL(new Blob([content],{type}));a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)}
function openModal(title,html){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBody').innerHTML=html;document.getElementById('modalBackdrop').style.display='flex'}
function closeModal(){document.getElementById('modalBackdrop').style.display='none'}
function field(label,name,type='text',value='',opts=''){return `<div class="field"><label>${label}</label>${type==='select'?`<select name="${name}" required>${opts}</select>`:`<input name="${name}" type="${type}" value="${esc(value)}" required>`}</div>`}
function openBuildingForm(){if(!canAdmin())return toast('Administrator access required');openModal('Register building',`<form onsubmit="saveBuilding(event)"><div class="form-grid">${field('Building code','code')}${field('Building name','name')}${field('Address','address','text')}</div><p class="actions" style="margin-top:15px"><button>Save building</button></p></form>`)}
function saveBuilding(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));if(db.buildings.some(b=>b.code.toLowerCase()===d.code.toLowerCase()))return toast('Building code already exists');db.buildings.push({id:uid('b'),...d,status:'ACTIVE'});save();closeModal();render();toast('Building registered')}
function openFloorForm(buildingId=''){if(!canAdmin())return toast('Administrator access required');if(!db.buildings.length)return toast('Add a building first');openModal('Add floor',`<form onsubmit="saveFloor(event)"><div class="form-grid">${field('Building','buildingId','select','','<option value="">Select building</option>'+db.buildings.map(b=>`<option value="${b.id}" ${b.id===buildingId?'selected':''}>${esc(b.name)}</option>`).join(''))}${field('Floor name','name')}${field('Floor order (ground = 0)','order','number','0')}</div><p style="margin-top:15px"><button>Save floor</button></p></form>`)}
function saveFloor(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));db.floors.push({id:uid('f'),buildingId:d.buildingId,name:d.name,order:Number(d.order)});save();closeModal();render();toast('Floor added')}
function openRoomForm(){if(!canAdmin())return toast('Administrator access required');if(!db.floors.length)return toast('Add a floor first');openModal('Register room',`<form onsubmit="saveRoom(event)"><div class="form-grid">${field('Floor','floorId','select','','<option value="">Select floor</option>'+db.floors.map(f=>`<option value="${f.id}">${esc(buildingOfFloor(f.id)?.name)} – ${esc(f.name)}</option>`).join(''))}${field('Room number','number')}${field('Room type','type','select','',''+['Classroom','Computer Lab','Civil Lab','Science Lab','Seminar Hall','Meeting Room','Faculty Room','Office','Library','Other'].map(x=>`<option>${x}</option>`).join(''))}${field('Department','department')}${field('Design capacity','capacity','number','60')}${field('Usable seating capacity','seats','number','60')}${field('Area (sq. m)','area','number','')}${field('Room in-charge','incharge','text','') }<div class="field full"><label>Facilities (comma separated)</label><input name="features" placeholder="Projector, Wi-Fi, AC"></div><div class="field full"><label><input type="checkbox" name="published" style="width:auto"> Publish in public room search</label></div></div><p style="margin-top:15px"><button>Save room</button></p></form>`)}
function saveRoom(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));d.capacity=Number(d.capacity);d.seats=Number(d.seats);d.area=Number(d.area||0);if(d.seats>d.capacity||d.seats<1)return toast('Usable seats must be between 1 and design capacity');if(db.rooms.some(r=>r.floorId===d.floorId&&r.number.toLowerCase()===d.number.toLowerCase()))return toast('Room number already exists on this floor');d.features=d.features.split(',').map(x=>x.trim()).filter(Boolean);d.published=e.target.published.checked;d.status='ACTIVE';db.rooms.push({id:uid('r'),...d});save();closeModal();render();toast('Room registered')}
function openBookingForm(roomId=''){if(!canBook())return toast('Please sign in as university staff to request a booking');let active=db.rooms.filter(r=>r.status==='ACTIVE'&&r.published);openModal('Request a room booking',`<form onsubmit="saveBooking(event)"><div class="form-grid">${field('Room','roomId','select','','<option value="">Select room</option>'+active.map(r=>`<option value="${r.id}" ${r.id===roomId?'selected':''}>${roomName(r.id)} · ${esc(r.type)} · ${r.seats} seats</option>`).join(''))}${field('Date','date','date',today())}${field('Start time','start','time','10:00')}${field('End time','end','time','11:00')}${field('Purpose','purpose')}${field('Expected attendees','attendees','number','10')}${field('Requester name','requester','text',role==='FACULTY'?'Demo Faculty':'Demo User')}<div class="field full"><label>Remarks</label><textarea name="remarks" rows="2"></textarea></div></div><p class="tiny muted">Demo policy: requests must be made at least 48 hours ahead. Administrator can configure this in a production system.</p><button>Submit booking request</button></form>`)}
function bookingValid(roomId,date,start,end,attendees,ignoreId=''){let r=db.rooms.find(x=>x.id===roomId);if(!r||r.status!=='ACTIVE'||!r.published)return toast('Room is not operational or published'),false;if(Number(attendees)>r.seats)return toast('Attendees exceed usable seating capacity'),false;if(end<=start)return toast('End time must be after start time'),false;let requested=new Date(date+'T'+start);if(requested<new Date(Date.now()+48*3600000))return toast('Booking must be requested at least 48 hours in advance'),false;let overlap=(a,b,c,d)=>a<d&&c<b;
if(db.bookings.some(x=>x.id!==ignoreId&&x.roomId===roomId&&x.date===date&&['APPROVED','PENDING'].includes(x.status)&&overlap(start,end,x.start,x.end)))return toast('A pending or approved booking overlaps this time'),false;
let day=new Date(date+'T12:00:00').toLocaleDateString('en-US',{weekday:'long'});if(db.timetable.some(t=>t.roomId===roomId&&t.day===day&&overlap(start,end,t.start,t.end)))return toast('Timetable allocation conflict'),false;
if(db.maintenance.some(m=>m.roomId===roomId&&m.status==='OPEN'&&date>=m.start&&date<=m.end))return toast('Room is blocked for maintenance'),false;return true}
function saveBooking(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));if(!bookingValid(d.roomId,d.date,d.start,d.end,d.attendees))return;db.bookings.push({id:'BK-'+Date.now().toString().slice(-7),...d,attendees:Number(d.attendees),type:'ADHOC',status:'PENDING'});save();closeModal();render();toast('Booking request submitted')}
function openTimetableForm(){if(!canAdmin())return toast('Administrator access required');let rooms=db.rooms.filter(r=>r.status==='ACTIVE');openModal('Add recurring timetable slot',`<form onsubmit="saveTimetable(event)"><div class="form-grid">${field('Room','roomId','select','','<option value="">Select room</option>'+rooms.map(r=>`<option value="${r.id}">${roomName(r.id)}</option>`).join(''))}${field('Day','day','select','',''+['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map(x=>`<option>${x}</option>`).join(''))}${field('Start time','start','time','09:00')}${field('End time','end','time','10:00')}${field('Class / batch','className')}${field('Department','department')}${field('Expected strength','strength','number','60')}${field('Faculty','faculty')}</div><p style="margin-top:15px"><button>Save timetable slot</button></p></form>`)}
function saveTimetable(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));if(d.end<=d.start)return toast('End time must be after start time');if(db.timetable.some(t=>t.roomId===d.roomId&&t.day===d.day&&d.start<t.end&&t.start<d.end))return toast('Timetable conflict in this room');d.strength=Number(d.strength);db.timetable.push({id:uid('t'),...d});save();closeModal();render();toast('Timetable slot added')}
function openOccupancyForm(){if(!canApprove())return toast('Authorised in-charge access required');openModal('Record actual occupancy',`<form onsubmit="saveOccupancy(event)"><div class="form-grid">${field('Room','roomId','select','','<option value="">Select room</option>'+db.rooms.map(r=>`<option value="${r.id}">${roomName(r.id)}</option>`).join(''))}${field('Date','date','date',today())}${field('Actual start','start','time','09:00')}${field('Actual end','end','time','10:00')}${field('Scheduled strength','scheduled','number','0')}${field('Actual occupants','actual','number','0')}${field('Use status','status','select','','<option value="USED">Used</option><option value="PARTIAL">Partially used</option><option value="UNUSED">Unused</option>')}<div class="field full"><label>Remarks</label><textarea name="remarks"></textarea></div></div><p style="margin-top:15px"><button>Save occupancy record</button></p></form>`)}
function saveOccupancy(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));let r=db.rooms.find(x=>x.id===d.roomId);if(d.end<=d.start)return toast('End time must be after start time');if(Number(d.actual)>r.seats)return toast('Actual occupants exceed usable capacity');d.actual=Number(d.actual);d.scheduled=Number(d.scheduled);d.id=uid('oc');d.verifiedBy=role==='ADMIN'?'Administrator':'Room In-charge';db.occupancy.push(d);save();closeModal();render();toast('Occupancy recorded')}
function openMaintenanceForm(){if(!canAdmin())return toast('Administrator access required');openModal('Block room for maintenance',`<form onsubmit="saveMaintenance(event)"><div class="form-grid">${field('Room','roomId','select','','<option value="">Select room</option>'+db.rooms.map(r=>`<option value="${r.id}">${roomName(r.id)}</option>`).join(''))}${field('Start date','start','date',today())}${field('End date','end','date',today())}<div class="field full"><label>Issue / reason</label><textarea name="issue" required></textarea></div></div><p style="margin-top:15px"><button>Save maintenance block</button></p></form>`)}
function saveMaintenance(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));if(d.end<d.start)return toast('End date cannot be before start date');let conflicts=db.bookings.filter(b=>b.roomId===d.roomId&&['APPROVED','PENDING'].includes(b.status)&&b.date>=d.start&&b.date<=d.end);if(conflicts.length&&!confirm('There are existing bookings in this period. Continue and flag for administrator resolution?'))return;db.maintenance.push({id:uid('m'),...d,status:'OPEN'});let r=db.rooms.find(x=>x.id===d.roomId);r.status='MAINTENANCE';save();closeModal();render();toast('Maintenance period recorded')}
function resetDemo(){if(confirm('Reset all local prototype data to the original sample records?')){db=JSON.parse(JSON.stringify(seed));save();render();toast('Demo data reset')}}
